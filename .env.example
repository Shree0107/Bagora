# Copy this file to `.env.local` and fill in the real values.
# NEVER commit `.env.local` — it is ignored by .gitignore.
# See SETUP.md for where to find each value.

# --- Site ---------------------------------------------------------------
# Full URL of the site, no trailing slash.
# Local: http://localhost:3000   Production: https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings -> API Keys / Data API) -----------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or legacy "anon" key. Safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key (sb_secret_...) or legacy "service_role" key. SERVER ONLY — bypasses RLS.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Stripe (Developers -> API keys / Webhooks) -------------------------
# Secret key: sk_test_... in test mode, sk_live_... in live mode. SERVER ONLY.
STRIPE_SECRET_KEY=sk_test_xxx
# Signing secret of your webhook endpoint (or the one printed by `stripe listen`).
STRIPE_WEBHOOK_SECRET=whsec_xxx
