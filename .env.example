# Copy this file to `.env.local` and fill in the real values.
# NEVER commit `.env.local` — it is ignored by .gitignore.
# See SETUP.md for where to find each value.

# --- Site ---------------------------------------------------------------
# Full URL of the site, no trailing slash.
# Local: http://localhost:3000   Production: https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings -> API Keys / Data API) -----------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or legacy "anon" key. Safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key (sb_secret_...) or legacy "service_role" key. SERVER ONLY — bypasses RLS.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Razorpay — Dashboard -> Account & Settings -> API Keys ---------------
# Test keys start with rzp_test_, live keys with rzp_live_. SERVER ONLY.
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
# The secret YOU choose when creating the webhook (Dashboard -> Webhooks).
RAZORPAY_WEBHOOK_SECRET=xxx

# --- Optional storefront settings (each feature hides itself when empty) ----
# WhatsApp number with country code, digits only, e.g. 919876543210 (floating chat button + product page link).
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Customer service email shown on the contact page.
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- GST invoice (the invoice page stays hidden until all three are set) -----
GSTIN=
LEGAL_NAME=
# Use 
 for line breaks if your host needs a single line.
BUSINESS_ADDRESS=
